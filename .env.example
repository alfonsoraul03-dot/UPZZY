# Copy this file to .env and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API (or "Connect").
#
# Only EXPO_PUBLIC_* variables are bundled into the app, and the app ships to
# every phone, so they must be PUBLIC values. Never put the service-role /
# secret key here: the app refuses to start the backend if you do.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
